 "code": "class Dog {\n  constructor(name, age) {\n    this.name = name;\n    this.age = age;\n  }\n  bark() {\n    return `${this.name} says woof`;\n  }\n}\n\nconst rex = new Dog(\"Rex\", 3);\nconsole.log(rex.bark());\nconsole.log(Object.getPrototypeOf(rex) === Dog.prototype);\n",
